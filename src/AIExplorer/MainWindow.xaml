                        <Button x:Name="SearchButton"
                                Grid.Column="3"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="검색"
                                Width="74"
                                Margin="8,0,0,0"
                                Click="SearchButton_Click" />
                    </Grid>

                    <Border Grid.Row="2"
                            Background="{StaticResource SurfaceMutedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,7"
                            Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE946;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0" />
                            <TextBlock x:Name="SearchEngineStatusText"
                                       Grid.Column="1"
                                       Text="필수 AI 설정 필요"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Button x:Name="AiModelButton"
                                    Grid.Column="2"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="필수 AI 설치"
                                    Width="96"
                                    Height="28"
                                    Padding="8,3"
                                    Margin="8,0,0,0"
                                    FontSize="11"
                                    ToolTip="로컬 AI 모델 설치"
                                    Click="AiModelButton_Click" />
                        </Grid>
                    </Border>

                    <ProgressBar x:Name="SearchProgressBar"
                                 Grid.Row="3"
                                 Height="3"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="Transparent"
                                 Visibility="Collapsed" />

                    <Border x:Name="AdvancedAnalysisBar"
                            Grid.Row="4"
                            Background="{StaticResource SurfaceMutedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="9,7"
                            Margin="0,10,0,0"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="상위 결과 정밀 재평가"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Button x:Name="AdvancedAnalysisButton"
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="정밀 재평가"
                                    Height="28"
                                    Padding="10,3"
                                    Margin="8,0,0,0"
                                    FontSize="11"
                                    ToolTip="상위 50개 결과 정밀 분석"
                                    Click="AdvancedAnalysisButton_Click" />
                        </Grid>
                    </Border>

                    <Border x:Name="ResultRefineBar"
                            Grid.Row="5"
                            Background="{StaticResource SurfaceMutedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,6"
                            Margin="0,10,0,0"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="&#xE721;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="결과 안에서 다시 찾기"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBox x:Name="ResultRefineTextBox"
                                         Grid.Column="1"
                                         MinHeight="34"
                                         Padding="9,5"
                                         Margin="10,0,0,0"
                                         VerticalContentAlignment="Center"
                                         SpellCheck.IsEnabled="False"
                                         ToolTip="예: 한글로만 된 파일, 지하 3층, PDF만"
                                         KeyDown="ResultRefineTextBox_KeyDown" />
                                <Button x:Name="RefineResultsButton"
                                        Grid.Column="2"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="찾기"
                                        MinHeight="34"
                                        Padding="14,3"
                                        Margin="8,0,0,0"
                                        Click="RefineResultsButton_Click" />
                                <Button x:Name="ClearResultRefinementButton"
                                        Grid.Column="3"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="전체 결과로"
                                        MinHeight="34"
                                        Padding="10,3"
                                        Margin="8,0,0,0"
                                        IsEnabled="False"
                                        Click="ClearResultRefinementButton_Click" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="1,5,1,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ResultRefineInterpretationText"
                                           Text="해석:"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed" />
                                <TextBlock x:Name="ResultRefineStatusText"
                                           Grid.Column="1"
                                           Text="현재 결과에서 다시 검색"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="10.5"
                                           Margin="12,0,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <ProgressBar x:Name="ResultRefineProgressBar"
                                         Grid.Row="2"
                                         Height="3"
                                         Margin="0,4,0,0"
                                         Foreground="{StaticResource AccentBrush}"
                                         Background="Transparent"
                                         Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="6" Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="Collapsed">
                                <Button x:Name="IntegratedResultsViewButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="통합 결과"
                                        Height="30"
                                        Padding="10,3"
                                        Click="IntegratedResultsViewButton_Click" />
                                <Button x:Name="TitleResultsViewButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="빠른 이름·경로"
                                        Height="30"
                                        Padding="10,3"
                                        Margin="6,0,0,0"
                                        Click="TitleResultsViewButton_Click" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="결과 정렬"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0" />
                            <ComboBox x:Name="SearchResultSortComboBox"
                                      Grid.Column="2"
                                      Height="30"
                                      Padding="8,2"
                                      SelectedIndex="0"
                                      VerticalContentAlignment="Center"
                                      ToolTip="두 결과를 함께 정렬"
                                      SelectionChanged="SearchResultSortComboBox_SelectionChanged">
                                <ComboBoxItem Content="일치도순" />
                                <ComboBoxItem Content="드라이브·최상위 경로순" />
                                <ComboBoxItem Content="가나다순" />
                                <ComboBoxItem Content="수정 날짜순 (최신 먼저)" />
                            </ComboBox>
                        </Grid>

                        <Grid x:Name="SearchResultsHostGrid"
                              Grid.Row="1"
                              Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="IntegratedResultsColumn"
                                                  Width="*" />
                                <ColumnDefinition x:Name="ResultsSplitterColumn"
                                                  Width="8" />
                                <ColumnDefinition x:Name="TitleResultsColumn"
                                                  Width="1.05*" />
                            </Grid.ColumnDefinitions>

                        <Border x:Name="IntegratedResultsPane"
                                Grid.Column="0"
                                Background="{StaticResource SurfaceMutedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="2,0,2,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="통합 검색 결과"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="본문·OCR·AI 의미 검색"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10.5"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="{StaticResource AccentSoftBrush}"
                                            CornerRadius="9"
                                            Padding="8,4"
                                            VerticalAlignment="Top">
                                        <TextBlock x:Name="AiResultCountBadgeText"
                                                   Text="0개"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <ListBox x:Name="SearchResultsListBox"
                                             ItemsSource="{Binding SearchResults}"
                                             SelectionMode="Extended"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.IsDeferredScrollingEnabled="False"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             VirtualizingPanel.ScrollUnit="Pixel"
                                             VirtualizingPanel.CacheLength="1,2"
                                             VirtualizingPanel.CacheLengthUnit="Page"
                                             ItemContainerStyle="{StaticResource SearchResultItemStyle}"
                                             MouseDoubleClick="SearchResultsListBox_MouseDoubleClick"
                                             PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="SearchResultsListBox_PreviewMouseMove">
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="열기" Click="OpenSearchResultMenuItem_Click" />
                                                <MenuItem Header="파일 위치 열기" Click="OpenSearchResultLocationMenuItem_Click" />
                                                <Separator />
                                                <MenuItem Header="경로 복사" Click="CopySearchResultPathMenuItem_Click" />
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SurfaceBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="12"
                                                        Margin="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="30"
                                                                Height="30"
                                                                Background="{StaticResource AccentSoftBrush}"
                                                                CornerRadius="8"
                                                                VerticalAlignment="Top">
                                                            <Grid>
                                                                <Image Source="{Binding IconImage}"
                                                                       Width="20"
                                                                       Height="20"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Stretch="Uniform"
                                                                       SnapsToDevicePixels="True" />
                                                                <TextBlock Text="{Binding IconGlyph}"
                                                                           Style="{StaticResource IconGlyphFallbackStyle}"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           FontSize="14" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding FullPath}" />
                                                                <Border Grid.Column="1"
                                                                        Background="{StaticResource AccentSoftBrush}"
                                                                        CornerRadius="8"
                                                                        Padding="7,3"
                                                                        Margin="7,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding MatchDisplay}"
                                                                               Foreground="{StaticResource AccentBrush}"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold" />
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding DirectoryPath}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,3,0,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding FullPath}" />
                                                            <Border Height="128"
                                                                    Margin="0,8,0,0"
                                                                    Padding="5"
                                                                    Background="{StaticResource SurfaceMutedBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    ClipToBounds="True"
                                                                    Visibility="{Binding CanReservePreviewSpace, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    ToolTip="{Binding FullPath}">
                                                                <Grid>
                                                                    <TextBlock Text="&#xEB9F;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="22"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               Opacity="0.45"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                    <Image Source="{Binding PreviewImage}"
                                                                           Stretch="Uniform"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                                           SnapsToDevicePixels="True" />
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Text="{Binding Reason}"
                                                                       Foreground="#3F4D63"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,8,0,0" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                <TextBlock Text="{Binding RelevanceDisplay}"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Text="  ·  "
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="10" />
                                                                <TextBlock Text="{Binding TypeDisplay}"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="10" />
                                                                <TextBlock Text="  ·  "
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="10" />
                                                                <TextBlock Text="{Binding ModifiedDisplay}"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="10" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel x:Name="SearchPlaceholderPanel"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <Border Width="64"
                                                Height="64"
                                                Background="{StaticResource AccentSoftBrush}"
                                                CornerRadius="22"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE721;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="25"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="SearchPlaceholderTitle"
                                                   Text="통합 검색 결과"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,14,0,5" />
                                        <TextBlock x:Name="SearchPlaceholderDescription"
                                                   Text="파일 내용과 의미를 검색합니다."
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="270" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <GridSplitter x:Name="ResultsGridSplitter"
                                      Grid.Column="1"
                                      Width="8"
                                      HorizontalAlignment="Stretch"
                                      Background="Transparent"
                                      ShowsPreview="True" />

                        <Border x:Name="TitleResultsPane"
                                Grid.Column="2"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="2,0,2,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="빠른 이름·경로 검색"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="파일명·상위 폴더 즉시 검색"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10.5"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="{StaticResource AccentSoftBrush}"
                                            CornerRadius="9"
                                            Padding="8,4"
                                            VerticalAlignment="Top">
                                        <TextBlock x:Name="TitleResultCountBadgeText"
                                                   Text="0개"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <ListBox x:Name="TitleSearchResultsListBox"
                                             ItemsSource="{Binding TitleSearchResults}"
                                             SelectionMode="Extended"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.IsDeferredScrollingEnabled="False"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             VirtualizingPanel.ScrollUnit="Pixel"
                                             VirtualizingPanel.CacheLength="1,2"
                                             VirtualizingPanel.CacheLengthUnit="Page"
                                             ItemContainerStyle="{StaticResource SearchResultItemStyle}"
                                             MouseDoubleClick="TitleSearchResultsListBox_MouseDoubleClick"
                                             PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="TitleSearchResultsListBox_PreviewMouseMove">
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="열기" Click="OpenTitleSearchResultMenuItem_Click" />
                                                <MenuItem Header="파일 위치 열기" Click="OpenTitleSearchResultLocationMenuItem_Click" />
                                                <Separator />
                                                <MenuItem Header="경로 복사" Click="CopyTitleSearchResultPathMenuItem_Click" />
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SurfaceBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="12"
                                                        Margin="1,1,1,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="38" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="32"
                                                                Height="32"
                                                                Background="{StaticResource AccentSoftBrush}"
                                                                CornerRadius="9"
                                                                VerticalAlignment="Top">
                                                            <Grid>
                                                                <Image Source="{Binding IconImage}"
                                                                       Width="20"
                                                                       Height="20"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Stretch="Uniform" />
                                                                <TextBlock Text="{Binding IconGlyph}"
                                                                           Style="{StaticResource IconGlyphFallbackStyle}"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           FontSize="15" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="14"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding FullPath}" />
                                                                <Border Grid.Column="1"
                                                                        Background="{StaticResource AccentSoftBrush}"
                                                                        CornerRadius="8"
                                                                        Padding="7,3"
                                                                        Margin="7,0,0,0">
                                                                    <TextBlock Text="{Binding MatchDisplay}"
                                                                               Foreground="{StaticResource AccentBrush}"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold" />
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding DirectoryPath}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       Margin="0,4,0,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding FullPath}" />
                                                            <TextBlock Text="{Binding Reason}"
                                                                       Foreground="#3F4D63"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,7,0,0" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                                <TextBlock Text="{Binding TypeDisplay}"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="10" />
                                                                <TextBlock Text="  ·  "
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="10" />
                                                                <TextBlock Text="{Binding ModifiedDisplay}"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                           FontSize="10" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel x:Name="TitleSearchPlaceholderPanel"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <Border Width="64"
                                                Height="64"
                                                Background="{StaticResource AccentSoftBrush}"
                                                CornerRadius="22"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE8B7;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="25"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="TitleSearchPlaceholderTitle"
                                                   Text="이름·경로 검색 결과"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,14,0,5" />
                                        <TextBlock x:Name="TitleSearchPlaceholderDescription"
                                                   Text="파일명·경로 결과를 바로 표시합니다."
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="300" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="7" Margin="2,7,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="1.05*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SearchResultCountText"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" />
                        <TextBlock x:Name="TitleSearchStatusText"
                                   Grid.Column="2"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Text="이름·경로 검색 대기" />
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter x:Name="InstantTitleGridSplitter"
                          Grid.Column="5"
                          Width="7"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <!-- Everything-style instant title search -->
            <Border x:Name="InstantTitleSearchPanel"
                    Grid.Column="6"
                    Style="{StaticResource SurfaceCardStyle}"
                    Margin="0,10,12,10"
                    ClipToBounds="True">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="제목 일치 검색"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="입력 즉시 파일명 검색"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="9"
                                Padding="8,4"
                                VerticalAlignment="Top">
                            <TextBlock Text="입력 즉시 검색"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstantTitleQueryTextBox"
                                 MinHeight="42"
                                 Padding="12,0"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 SpellCheck.IsEnabled="False"
                                 ToolTip="파일명 또는 경로 입력"
                                 TextChanged="InstantTitleQueryTextBox_TextChanged" />
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE894;"
                                Width="34"
                                Height="34"
                                Margin="5,2,0,0"
                                ToolTip="검색어 지우기"
                                Click="ClearInstantTitleQueryButton_Click" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="InstantTitleAllRadio"
                                     GroupName="InstantTitleItemFilter"
                                     Content="모두"
                                     Style="{StaticResource SegmentRadioStyle}"
                                     IsChecked="True"
                                     Checked="InstantTitleSearchFilter_Changed" />
                        <RadioButton x:Name="InstantTitleFilesRadio"
                                     Grid.Column="1"
                                     GroupName="InstantTitleItemFilter"
                                     Content="파일"
                                     Style="{StaticResource SegmentRadioStyle}"
                                     Margin="5,0,0,0"
                                     Checked="InstantTitleSearchFilter_Changed" />
                        <RadioButton x:Name="InstantTitleFoldersRadio"
                                     Grid.Column="2"
                                     GroupName="InstantTitleItemFilter"
                                     Content="폴더"
                                     Style="{StaticResource SegmentRadioStyle}"
                                     Margin="5,0,0,0"
                                     Checked="InstantTitleSearchFilter_Changed" />
                    </Grid>

                    <WrapPanel Grid.Row="3" Margin="1,0,0,8">
                        <CheckBox x:Name="InstantTitleMatchCaseCheckBox"
                                  Content="대소문자"
                                  Margin="0,0,14,0"
                                  VerticalContentAlignment="Center"
                                  Checked="InstantTitleSearchFilter_Changed"
                                  Unchecked="InstantTitleSearchFilter_Changed" />
                        <CheckBox x:Name="InstantTitleWholeWordCheckBox"
                                  Content="전체 단어"
                                  Margin="0,0,14,0"
                                  VerticalContentAlignment="Center"
                                  Checked="InstantTitleSearchFilter_Changed"
                                  Unchecked="InstantTitleSearchFilter_Changed" />
                        <CheckBox x:Name="InstantTitleRegexCheckBox"
                                  Content="정규식"
                                  VerticalContentAlignment="Center"
                                  Checked="InstantTitleSearchFilter_Changed"
                                  Unchecked="InstantTitleSearchFilter_Changed" />
                    </WrapPanel>

                    <ComboBox x:Name="InstantTitleScopeComboBox"
                              Grid.Row="4"
                              Height="36"
                              Padding="8,3"
                              Margin="0,0,0,8"
                              SelectedIndex="0"
                              VerticalContentAlignment="Center"
                              SelectionChanged="InstantTitleScopeComboBox_SelectionChanged">
                        <ComboBoxItem Content="모든 드라이브" />
                        <ComboBoxItem Content="현재 폴더와 하위 폴더" />
                        <ComboBoxItem Content="현재 드라이브" />
                        <ComboBoxItem Content="등록된 네트워크" />
                        <ComboBoxItem Content="모든 위치 (로컬 + 네트워크)" />
                    </ComboBox>

                    <Grid x:Name="InstantTitleIndexProgressPanel"
                          Grid.Row="5"
                          Margin="1,0,1,1"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="InstantTitleIndexDetailText"
                                   Text="색인 위치를 확인하는 중..."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ShowDuration="60000" />
                        <ProgressBar x:Name="InstantTitleIndexProgressBar"
                                     Grid.Row="1"
                                     Height="5"
                                     Margin="0,5,0,0"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource AccentSoftBrush}" />
                    </Grid>

                    <Grid Grid.Row="6" Margin="0,7,0,0">
                        <ListView x:Name="InstantTitleResultsListView"
                                  ItemsSource="{Binding InstantTitleSearchResults}"
                                  SelectionMode="Extended"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="1"
                                  Background="{StaticResource SurfaceBrush}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  MouseDoubleClick="InstantTitleResultsListView_MouseDoubleClick"
                                  PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="InstantTitleResultsListView_PreviewMouseMove">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="열기" Click="OpenInstantTitleResultMenuItem_Click" />
                                    <MenuItem Header="파일 위치 열기" Click="OpenInstantTitleResultLocationMenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="경로 복사" Click="CopyInstantTitleResultPathMenuItem_Click" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView AllowsColumnReorder="True">
                                    <GridViewColumn Width="180">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="이름"
                                                                  Tag="Name"
                                                                  Click="InstantTitleColumnHeader_Click" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                                    <Grid Width="24" Height="18">
                                                        <Image Source="{Binding IconImage}"
                                                               Width="16"
                                                               Height="16"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding IconGlyph}"
                                                                   Style="{StaticResource IconGlyphFallbackStyle}"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="14" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FullPath}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="260">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="경로"
                                                                  Tag="Path"
                                                                  Click="InstantTitleColumnHeader_Click" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DirectoryPath}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FullPath}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="88">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="크기"
                                                                  Tag="Size"
                                                                  Click="InstantTitleColumnHeader_Click" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SizeDisplay}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="132">
                                        <GridViewColumn.Header>
                                            <GridViewColumnHeader Content="수정한 날짜"
                                                                  Tag="Modified"
                                                                  Click="InstantTitleColumnHeader_Click" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ModifiedDisplay}"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel x:Name="InstantTitleSearchPlaceholderPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <Border Width="58"
                                    Height="58"
                                    Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="20"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="23"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="InstantTitleSearchPlaceholderTitle"
                                       Text="파일명을 입력하세요"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,13,0,4" />
                            <TextBlock x:Name="InstantTitleSearchPlaceholderDescription"
                                       Text="입력 즉시 결과 표시"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="280" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="7" Margin="1,7,1,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="InstantTitleResultStatusText"
                                   Text="검색 대기"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="InstantTitleIndexStatusText"
                                   Grid.Column="1"
                                   Text="색인 준비 중"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10.5"
                                   Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="준비"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="IndexStatusIndicator"
                             Width="6"
                             Height="6"
                             Fill="{StaticResource SuccessBrush}"
                             Margin="0,0,6,0" />
                    <TextBlock x:Name="IndexStatusText"
                               Text="색인 준비 중"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
