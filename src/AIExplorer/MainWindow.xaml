<Window x:Class="AIExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AIExplorer.Models"
        Title="AI 탐색기"
        Width="1920"
        Height="980"
        MinWidth="1500"
        MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>
        <Style x:Key="NavigationTreeItemStyle"
               TargetType="TreeViewItem"
               BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <EventSetter Event="Expanded" Handler="NavigationTreeItem_Expanded" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="NavigationTreeItem_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseMove" Handler="NavigationTreeItem_PreviewMouseMove" />
        </Style>

        <Style x:Key="IconGlyphFallbackStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconImage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder"
                                        Property="Background"
                                        Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="SegmentBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type models:NavigationNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2,4">
                <Grid Width="24" Height="18">
                    <Image Source="{Binding IconImage}"
                           Width="16"
                           Height="16"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True" />
                    <TextBlock Text="{Binding IconGlyph}"
                               Style="{StaticResource IconGlyphFallbackStyle}"
                               FontSize="14" />
                </Grid>
                <TextBlock Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="182"
                           ToolTip="{Binding Path}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Application header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="30"
                        Height="30"
                        CornerRadius="9"
                        VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6477F2" Offset="0" />
                            <GradientStop Color="#4051C8" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#xE8B7;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="White"
                               FontSize="15"
                               HorizontalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <TextBlock Text="AI 탐색기"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock Text="파일을 찾는 가장 익숙한 방법"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               Margin="12,1,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPillStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{StaticResource SuccessBrush}"
                                     Margin="0,0,6,0" />
                            <TextBlock Text="로컬 전용"
                                       Foreground="{StaticResource SuccessBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE713;"
                            ToolTip="설정"
                            Click="SettingsButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Unified command bar -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BackButton"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE72B;"
                                ToolTip="뒤로 (Alt+왼쪽, Backspace, 마우스 뒤로)"
                                Click="BackButton_Click" />
                        <Button x:Name="ForwardButton"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE72A;"
                                ToolTip="앞으로 (Alt+오른쪽, 마우스 앞으로)"
                                Click="ForwardButton_Click" />
                        <Button x:Name="UpButton"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE74A;"
                                ToolTip="상위 폴더 (Alt+위쪽)"
                                Click="UpButton_Click" />
                        <Button Style="{StaticResource IconButtonStyle}"
                                Content="&#xE72C;"
                                ToolTip="새로고침 (F5)"
                                Click="RefreshButton_Click" />

                        <Border Width="1"
                                Height="24"
                                Background="{StaticResource BorderBrush}"
                                Margin="8,0" />

                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="새 폴더 (Ctrl+Shift+N)"
                                Click="NewFolderButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F4;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="새 폴더" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="잘라내기 (Ctrl+X)"
                                Click="CutButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C6;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="잘라내기" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="복사 (Ctrl+C)"
                                Click="CopyButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="복사" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="붙여넣기 (Ctrl+V)"
                                Click="PasteButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77F;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="붙여넣기" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="이름 변경 (F2)"
                                Click="RenameButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8AC;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="이름 변경" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="휴지통으로 이동 (Delete)"
                                Click="DeleteButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="삭제" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Background="{StaticResource SurfaceBrush}">
                    <TextBlock Text="정렬"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="8,0,6,0" />
                    <ComboBox x:Name="SortComboBox"
                              Width="104"
                              Height="34"
                              Padding="8,3"
                              VerticalContentAlignment="Center"
                              SelectedIndex="0"
                              SelectionChanged="SortComboBox_SelectionChanged">
                        <ComboBoxItem Content="이름" />
                        <ComboBoxItem Content="수정한 날짜" />
                        <ComboBoxItem Content="유형" />
                        <ComboBoxItem Content="크기" />
                    </ComboBox>
                    <Button x:Name="SearchPanelToggleButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="8,0,0,0"
                            ToolTip="지능 검색 패널 표시 또는 숨기기"
                            Click="SearchPanelToggleButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Margin="0,0,7,0" />
                            <TextBlock Text="통합 검색" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Explorer workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="260" />
                <ColumnDefinition x:Name="NavigationSplitterColumn" Width="5" />
                <ColumnDefinition x:Name="CurrentFolderColumn"
                                  Width="1.55*"
                                  MinWidth="520" />
                <ColumnDefinition x:Name="SearchSplitterColumn" Width="7" />
                <ColumnDefinition x:Name="SearchPanelColumn"
                                  Width="1.2*"
                                  MinWidth="470" />
                <ColumnDefinition x:Name="InstantTitleSplitterColumn" Width="7" />
                <ColumnDefinition x:Name="InstantTitlePanelColumn"
                                  Width="0.92*"
                                  MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Navigation tree -->
            <Border x:Name="NavigationPanel"
                    Grid.Column="0"
                    Style="{StaticResource SurfaceCardStyle}"
                    Margin="12,10,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="14,0">
                        <TextBlock Text="탐색"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                    </Grid>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <TreeView x:Name="NavigationTree"
                                  ItemsSource="{Binding NavigationRoots}"
                                  ItemContainerStyle="{StaticResource NavigationTreeItemStyle}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Padding="8,8,4,8"
                                  AllowDrop="True"
                                  PreviewDragOver="NavigationTree_PreviewDragOver"
                                  Drop="NavigationTree_Drop"
                                  PreviewMouseRightButtonDown="NavigationTree_PreviewMouseRightButtonDown"
                                  SelectedItemChanged="NavigationTree_SelectedItemChanged">
                            <TreeView.ContextMenu>
                                <ContextMenu Opened="NavigationTreeContextMenu_Opened">
                                    <MenuItem x:Name="AddNavigationFolderToFavoritesMenuItem"
                                              Header="즐겨찾기에 추가"
                                              Click="AddNavigationFolderToFavoritesMenuItem_Click" />
                                    <Separator x:Name="FavoriteAddSeparator" />
                                    <MenuItem x:Name="RenameFavoriteMenuItem"
                                              Header="즐겨찾기 이름 변경"
                                              Click="RenameFavoriteMenuItem_Click" />
                                    <MenuItem x:Name="RemoveFavoriteMenuItem"
                                              Header="즐겨찾기에서 제거"
                                              Click="RemoveFavoriteMenuItem_Click" />
                                    <Separator x:Name="FavoriteEditSeparator" />
                                    <MenuItem Header="목록 새로고침"
                                              Click="RefreshNavigationMenuItem_Click" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource SurfaceMutedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="13"
                                       Margin="0,0,7,0" />
                            <TextBlock Text="끌어서 추가"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10.5"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter x:Name="NavigationGridSplitter"
                          Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True" />

            <!-- Current folder -->
            <Border x:Name="CurrentFolderPanel"
                    Grid.Column="2"
                    Style="{StaticResource SurfaceCardStyle}"
                    Margin="7,10,7,10"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="3" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image x:Name="CurrentFolderIcon"
                               Width="18"
                               Height="18"
                               Margin="2,0,10,0"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True" />
                        <TextBox x:Name="PathTextBox"
                                 Grid.Column="1"
                                 Height="36"
                                 VerticalAlignment="Center"
                                 KeyDown="PathTextBox_KeyDown"
                                 ToolTip="경로를 입력하고 Enter를 누르세요." />
                        <Button x:Name="AddCurrentPathToFavoritesButton"
                                Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="☆ 즐겨찾기"
                                Height="36"
                                MinWidth="104"
                                Margin="8,0,0,0"
                                Padding="10,0"
                                VerticalAlignment="Center"
                                ToolTip="현재 경로를 즐겨찾기에 추가합니다."
                                Click="AddCurrentPathToFavoritesButton_Click" />
                        <TextBlock Grid.Column="3"
                                   x:Name="FolderItemCountText"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="12,0,2,0" />
                    </Grid>

                    <ProgressBar x:Name="NavigationProgressBar"
                                 Grid.Row="1"
                                 Height="3"
                                 IsIndeterminate="True"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="Transparent"
                                 Visibility="Collapsed" />

                    <Grid Grid.Row="2">
                        <ListView x:Name="FileListView"
                                  ItemsSource="{Binding FileItems}"
                                  SelectionMode="Extended"
                                  BorderThickness="0"
                                  Background="{StaticResource SurfaceBrush}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  MouseDoubleClick="FileListView_MouseDoubleClick"
                                  PreviewMouseRightButtonDown="FileListView_PreviewMouseRightButtonDown"
                                  PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="FileListView_PreviewMouseMove"
                                  AllowDrop="True"
                                  DragOver="FileListView_DragOver"
                                  Drop="FileListView_Drop">
                            <ListView.ContextMenu>
                                <ContextMenu Opened="FileListContextMenu_Opened">
                                    <MenuItem Header="열기" Click="OpenMenuItem_Click" />
                                    <MenuItem Header="파일 위치 열기" Click="OpenLocationMenuItem_Click" />
                                    <MenuItem x:Name="AddSelectedFolderToFavoritesMenuItem"
                                              Header="즐겨찾기에 추가"
                                              Click="AddSelectedFolderToFavoritesMenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="잘라내기" Click="CutButton_Click" InputGestureText="Ctrl+X" />
                                    <MenuItem Header="복사" Click="CopyButton_Click" InputGestureText="Ctrl+C" />
                                    <MenuItem Header="붙여넣기" Click="PasteButton_Click" InputGestureText="Ctrl+V" />
                                    <Separator />
                                    <MenuItem Header="이름 변경" Click="RenameButton_Click" InputGestureText="F2" />
                                    <MenuItem Header="삭제" Click="DeleteButton_Click" InputGestureText="Delete" />
                                    <Separator />
                                    <MenuItem Header="경로 복사" Click="CopyPathMenuItem_Click" />
                                    <MenuItem Header="속성" Click="PropertiesMenuItem_Click" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="340">
                                        <GridViewColumn.Header>
                                            <TextBlock Text="이름" />
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                                    <Grid Width="28" Height="20">
                                                        <Image Source="{Binding IconImage}"
                                                               Width="16"
                                                               Height="16"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               Stretch="Uniform"
                                                               SnapsToDevicePixels="True" />
                                                        <TextBlock Text="{Binding IconGlyph}"
                                                                   Style="{StaticResource IconGlyphFallbackStyle}"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="16" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FullPath}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="수정한 날짜"
                                                    Width="155"
                                                    DisplayMemberBinding="{Binding ModifiedDisplay}" />
                                    <GridViewColumn Header="유형"
                                                    Width="160"
                                                    DisplayMemberBinding="{Binding TypeDisplay}" />
                                    <GridViewColumn Header="크기"
                                                    Width="90"
                                                    DisplayMemberBinding="{Binding SizeDisplay}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel x:Name="FileEmptyPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                            <Border Width="58"
                                    Height="58"
                                    Background="{StaticResource SurfaceMutedBrush}"
                                    CornerRadius="20"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE838;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="24"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="이 폴더는 비어 있습니다"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,4" />
                            <TextBlock Text="파일을 끌어 놓아 추가하세요."
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter x:Name="SearchGridSplitter"
                          Grid.Column="3"
                          Width="7"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <!-- AI search -->
            <Border x:Name="SearchPanel"
                    Grid.Column="4"
                    Style="{StaticResource SurfaceCardStyle}"
                    Margin="0,10,0,10"
                    ClipToBounds="True"
                    SizeChanged="SearchPanel_SizeChanged">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="지능 검색"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <Border Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="9"
                                        Padding="8,3"
                                        Margin="8,0,0,0">
                                    <TextBlock Text="LOCAL LLM"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="이름·본문·OCR·이미지 통합 검색"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                            <Border x:Name="NaturalLanguageInterpretationBar"
                                    Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="8"
                                    Padding="9,5"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Left"
                                    MaxWidth="980"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="이해한 내용"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Margin="0,0,8,0" />
                                    <TextBlock x:Name="NaturalLanguageInterpretationText"
                                               Foreground="#3446B6"
                                               FontSize="10.5"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}"
                                Width="30"
                                Height="30"
                                Content="&#xE76B;"
                                ToolTip="지능 검색 패널 접기"
                                Click="CollapseSearchPanelButton_Click" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchQueryTextBox"
                                 Height="38"
                                 ToolTip="{x:Null}"
                                 SpellCheck.IsEnabled="False"
                                 UndoLimit="32"
                                 TextChanged="SearchQueryTextBox_TextChanged"
                                 GotKeyboardFocus="SearchQueryTextBox_GotKeyboardFocus"
                                 LostKeyboardFocus="SearchQueryTextBox_LostKeyboardFocus"
                                 KeyDown="SearchQueryTextBox_KeyDown" />
                        <ComboBox x:Name="SearchScopeComboBox"
                                  Grid.Column="1"
                                  Height="38"
                                  Padding="8,3"
                                  Margin="8,0,0,0"
                                  SelectedIndex="0"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="현재 폴더와 하위 폴더" />
                            <ComboBoxItem Content="현재 드라이브" />
                            <ComboBoxItem Content="현재 위치 + 등록된 네트워크" />
